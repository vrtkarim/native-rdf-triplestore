@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/> .

ex:alice
    foaf:knows <http://example.org/bob> ;
    foaf:knows ex:carol ;
    foaf:name  "Alice" ;
    foaf:age   30 ;
    ex:worksAt ex:Acme .

ex:bob
    foaf:name  "Bob \"The Builder\"" ;
    foaf:age   31 ;
    foaf:knows ex:carol ;
    a          foaf:Person .

ex:carol
    foaf:name  "Carol" ;
    foaf:age   29 ;
    foaf:knows ex:alice ;
    a          foaf:Person .

ex:Acme
    ex:name    "Acme Corporation" ;
    ex:city    "London" ;
    ex:employee ex:alice ;
    ex:employee ex:bob .

ex:project1
    ex:name        "RDF Triplestore" ;
    ex:description "A small RDF database written in C" ;
    ex:owner       ex:alice ;
    ex:status      "active" .
